---
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/chat.css';
import ChatWidget from '../components/ChatWidget.astro';

// PlanPebble preview: a June calendar where pebbles show how many people are free each day.
const freeByDay: Record<number, number> = { 3: 1, 5: 2, 9: 1, 11: 3, 12: 2, 16: 2, 17: 4, 19: 1, 23: 2, 24: 1, 26: 3, 30: 1 };
const PICKED_DAY = 17;
const pebbleDays = Array.from({ length: 35 }, (_, i) => {
  const n = i >= 1 && i <= 30 ? i : 0; // June 2026 starts on a Monday
  return { n, free: freeByDay[n] ?? 0, pick: n === PICKED_DAY };
});
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <script is:inline>
    document.documentElement.classList.replace('no-js', 'js');
    // Safety net: if the motion script hasn't started after 4s, show everything.
    setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.add('motion-fallback'); }, 4000);
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="F-Banda — An in depth look at my software development journey, projects, and interests."/>
  <meta name="theme-color" content="#090d14" />
  <title>F-Banda — An in depth look at my software development journey, projects, and interests.</title>

  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/images/favicon.ico" />
</head>
<body>
  <div class="site-glow site-glow--one" aria-hidden="true" data-glow></div>
  <div class="site-glow site-glow--two" aria-hidden="true" data-glow></div>
  <div class="noise" aria-hidden="true"></div>
  <div class="scroll-progress" aria-hidden="true"><span data-progress></span></div>
  <div class="cursor-glow" aria-hidden="true" data-cursor-glow></div>

  <header class="site-header" data-header>
    <div class="shell nav-wrap">
      <a class="brand" href="#top" aria-label="Francisco Banda home">
        <span class="brand-mark">FB</span>
        <span class="brand-name">Francisco Banda</span>
      </a>

      <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-toggle>
        <span></span><span></span>
      </button>

      <nav class="nav" aria-label="Primary navigation" data-nav>
        <a href="#about" data-nav-link>About</a>
        <a href="#experience" data-nav-link>Experience</a>
        <a href="#projects" data-nav-link>Projects</a>
        <a href="#skills" data-nav-link>Skills</a>
        <a href="#resume" data-nav-link>Resume</a>
        <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
        <a class="nav-resume magnetic" href="#contact" data-chat-open aria-haspopup="dialog">Contact ↗<span aria-hidden="true"></span></a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero shell" id="top">
      <div class="hero-copy" data-hero-copy>
        <p class="eyebrow" data-hero-item><span class="status-dot"></span> Software Developer · Computer Science</p>
        <h1 data-hero-title>
          Hey, I’m<br />
          <span class="gradient-text">Francisco.</span>
        </h1>
        <p class="hero-lede" data-hero-item>
          I’m an aspiring software developer with a CS background who enjoys full-stack development, discussing new ideas,
          and continuously diving into new tech innovations.
        </p>
        <div class="hero-actions" data-hero-item>
          <a class="button button--primary magnetic" href="#projects">Projects <span aria-hidden="true">↓</span></a>
          <a class="button button--secondary magnetic" href="#about">About me</a>
        </div>
        <div class="hero-stack" aria-label="Primary technologies" data-hero-stack>
          <span>C++</span><span>C#</span><span>.NET</span><span>Python</span><span>SQL</span><span>Full-Stack</span>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true" data-hero-visual>
        <div class="system-card" data-tilt>
          <div class="system-card__top">
            <span class="window-dots"><i></i><i></i><i></i></span>
            <span>user.profile</span>
          </div>
          <div class="system-card__body">
            <div class="code-line"><span class="code-key">engineer</span><span class="code-muted">:</span> <span class="code-value">"Francisco Banda"</span></div>
            <div class="code-line"><span class="code-key">interests</span><span class="code-muted">:</span> <span class="code-value">[</span></div>
            <div class="code-line code-indent"><span class="code-string">"full-stack development"</span>,</div>
            <div class="code-line code-indent"><span class="code-string">"innovative solutions"</span>,</div>
            <div class="code-line code-indent"><span class="code-string">"AI infrastructure"</span></div>
            <div class="code-line"><span class="code-value">]</span></div>
            <div class="terminal-line"><span>&gt;</span> <span data-type>git commit -m "Goal is to keep learning and contributing to the world of tech."</span><span class="cursor"></span></div>
          </div>
        </div>
        <div class="floating-stat floating-stat--one"><strong>B.S.</strong><span>Computer Science</span></div>
        <div class="floating-stat floating-stat--two"><strong>API</strong><span>Full-Stack · Data · Systems</span></div>
      </div>
    </section>

    <section class="section shell" id="about">
      <div class="section-heading reveal">
        <p class="section-kicker" data-scramble>01 / About</p>
        <h2 data-split>A little about me.</h2>
      </div>

      <div class="about-grid">
        <div class="about-copy reveal">
          <p class="lead-copy">
            I'm a passionate software engineer who thrives on problem-solving. Enjoying the full-stack development process; from designing and
            implementing backend systems to working the frontend and user experience. I'm always eager to take on new challenges and contribute.
          </p>
          <p>
            My computer science background spans between application development, low-level systems work, and software product delivery.
            Over time that has taken me through the full development life-cycle, systems programming, cloud infrastructure,
            automation, data processing, and plenty of side projects that started with “I wonder if I can make this work.”
          </p>
          <p>
            Away from development, you’ll usually find me with family, doing research, or working on my vehicles.
          </p>
        </div>

        <div class="about-card reveal">
          <div class="about-card__row">
            <span>Based in</span>
            <strong>Waukegan, IL - USA</strong>
          </div>
          <div class="about-card__row">
            <span>Education</span>
            <strong>B.S. Computer Science</strong>
          </div>
          <div class="about-card__row">
            <span>School</span>
            <strong>Northern Illinois University</strong>
          </div>
          <div class="about-card__row">
            <span>Primary interest</span>
            <strong>Coding / Systems</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section shell" id="experience">
      <div class="section-heading reveal">
        <p class="section-kicker" data-scramble>02 / Experience</p>
        <h2 data-split>Where I’ve worked.</h2>
      </div>

      <div class="timeline" data-timeline>
        <article class="timeline-item reveal">
          <div class="timeline-date">2025 — 2026</div>
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-content">
            <div class="job-heading">
              <div>
                <h3>Full Stack Developer</h3>
                <p>Kenstera</p>
              </div>
              <span class="job-type">Backend Workflows</span>
            </div>
            <ul>
              <li>Designed and implemented Python backend qualification logic to process structured data produced by an automated LLM-based intake system</li>
              <li>Built decision workflows to evaluate legal case criteria and route qualified matters for human review while deferring or redirecting non-qualifying cases</li>
              <li>Maintained technical documentation for workflows, processes, and system functionality</li>
              <li>Communicated with existing and potential clients to answer questions or resolve technical issues</li>
            </ul>
            <div class="tag-row"><span>Python</span><span>Decision Logic</span><span>LLM Workflows</span><span>Data Processing</span></div>
          </div>
        </article>

        <article class="timeline-item reveal">
          <div class="timeline-date">2023 — 2025</div>
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-content">
            <div class="job-heading">
              <div>
                <h3>Software Developer</h3>
                <p>PlayGuard.ac</p>
              </div>
              <span class="job-type">Backend Systems</span>
            </div>
            <ul>
              <li>Developed scalable backend services using Go and NoSQL databases</li>
              <li>Designed and implemented server-side systems and infrastructure, ingesting stream data to dynamically calculate risk factors</li>
              <li>Improved AI-powered scanning by enhancing test coverage, enabling more accurate memory fragment analysis</li>
              <li>Investigated, reproduced, and diagnosed technical issues such as system faults to identify root causes and improve system stability</li>
            </ul>
            <div class="tag-row"><span>Go</span><span>NoSQL</span><span>AWS</span><span>Python</span></div>
          </div>
        </article>

        <article class="timeline-item reveal">
          <div class="timeline-date">2018 — 2022</div>
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-content">
            <div class="job-heading">
              <div>
                <h3>Technical Solutions Engineer</h3>
                <p>IZI Solutions Freelance</p>
              </div>
              <span class="job-type">Development & Operations</span>
            </div>
            <ul>
              <li>Discussed software planning with clients, detailing specifications to ensure client satisfaction</li>
              <li>Developed numerous projects in C++, C#, and Python - tailored to the client’s expectations</li>
              <li>Integrated Lua scripting into C++ applications and configured backend services and APIs</li>
              <li>Provided direct technical support to clients and users, troubleshooting software issues and answering technical questions</li>
            </ul>
            <div class="tag-row"><span>C++</span><span>C#</span><span>SQL</span><span>Python</span><span>APIs</span></div>
          </div>
        </article>
      </div>
    </section>

    <section class="section shell" id="projects">
      <div class="section-heading section-heading--split reveal">
        <div>
          <p class="section-kicker" data-scramble>03 / Projects</p>
          <h2 data-split>Things I’ve built.</h2>
        </div>
        <p>A few projects I’ve enjoyed working on, from sports data visualization to CPU emulation.</p>
      </div>

      <div class="project-grid">
        <article class="project-card reveal" data-spotlight data-project-trigger tabindex="0" role="button" aria-label="Open NFL Data Visualizer project" aria-haspopup="dialog">
          <div class="project-preview data-preview" aria-hidden="true" data-parallax-box>
            <div class="field-lines"></div>
            <div class="player player--1"><span>23</span></div>
            <div class="player player--2"><span>11</span></div>
            <div class="player player--3"><span>87</span></div>
            <div class="route route--1"></div>
            <div class="route route--2"></div>
            <div class="preview-label">REAL-TIME PLAY DATA</div>
          </div>
          <div class="project-body">
            <div class="project-number">01</div>
            <div>
              <p class="project-meta">Data visualization · 2022</p>
              <h3>NFL Data Visualizer - Click to View</h3>
              <p>
                Built using NFL Special Plays data - it renders player movement from
                individual plays and gave me a good reason to work through a large real-world dataset.
              </p>
              <div class="tag-row"><span>JavaScript</span><span>HTML</span><span>Data Processing/Visualizing</span></div>
            </div>
          </div>
        </article>

        <a class="project-card reveal" data-spotlight href="https://github.com/ProgrammingLuis/Intel8080" target="_blank" rel="noreferrer" aria-label="Open Intel 8080 Emulator repository in a new tab">
          <div class="project-preview arcade-preview" aria-hidden="true" data-parallax-box>
            <div class="arcade-stars"></div>
            <div class="pixel-invader pixel-invader--1">▟█▙<br>████<br>▛██▜</div>
            <div class="pixel-invader pixel-invader--2">▟█▙<br>████<br>▛██▜</div>
            <div class="pixel-cannon">▟█▙</div>
            <div class="preview-label">8080 CPU EMULATION</div>
          </div>
          <div class="project-body">
            <div class="project-number">02</div>
            <div>
              <p class="project-meta">Systems programming · 2020</p>
              <h3>Intel 8080 Emulator</h3>
              <p>
                An Intel 8080 emulator I built with another developer using C++ and SDL. It includes CPU instruction
                emulation, a disassembler, display and input handling, and eventually ran Space Invaders.
              </p>
              <div class="tag-row"><span>C++</span><span>SDL</span><span>CPU Emulation</span><span>Systems</span></div>
            </div>
          </div>
        </a>

        <a class="project-card reveal" data-spotlight href="https://planpebble.vercel.app/" target="_blank" rel="noreferrer" aria-label="Open PlanPebble in a new tab">
          <div class="project-preview pebble-preview" aria-hidden="true" data-parallax-box>
            <div class="pebble-cal">
              <div class="pebble-cal__head"><span>June</span><span class="pebble-cal__meta">4 / 4 free</span></div>
              <div class="pebble-cal__grid">
                {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d) => <span class="pebble-cal__dow">{d}</span>)}
                {pebbleDays.map((day) => (
                  <span class:list={['pebble-day', { 'pebble-day--empty': !day.n, 'pebble-day--pick': day.pick }]}>
                    {day.n > 0 && <b>{day.n}</b>}
                    {day.free > 0 && <i class="pebble-dots">{Array.from({ length: day.free }, () => <em class="pebble" />)}</i>}
                  </span>
                ))}
              </div>
            </div>
            <div class="preview-label">GROUP PLANNING</div>
          </div>
          <div class="project-body">
            <div class="project-number">03</div>
            <div>
              <p class="project-meta">Web app · Next build</p>
              <h3>PlanPebble</h3>
              <p>
                A group planning website, find a day that works for everyone. No sign-up, one link, make memories.
              </p>
              <div class="tag-row"><span>Next.js</span><span>TypeScript</span><span>Full-Stack</span></div>
              <span class="project-cta">Check it out →</span>
            </div>
          </div>
        </a>
      </div>
    </section>

    <section class="section shell" id="skills">
      <div class="section-heading reveal">
        <p class="section-kicker" data-scramble>04 / Toolkit</p>
        <h2 data-split>Things I work with.</h2>
      </div>

      <div class="skills-grid">
        <div class="skill-card reveal" data-spotlight>
          <span class="skill-index">01</span>
          <h3>Languages</h3>
          <p>C++ · C# · Python · Go · Java · JavaScript · SQL</p>
        </div>
        <div class="skill-card reveal" data-spotlight>
          <span class="skill-index">02</span>
          <h3>Backend</h3>
          <p>.NET · ASP.NET · REST APIs · Node.js · Server-side application design</p>
        </div>
        <div class="skill-card reveal" data-spotlight>
          <span class="skill-index">03</span>
          <h3>Data</h3>
          <p>SQL · SQL Server · NoSQL · Data processing · Structured & unstructured data</p>
        </div>
        <div class="skill-card reveal" data-spotlight>
          <span class="skill-index">04</span>
          <h3>Infrastructure</h3>
          <p>AWS EC2 · S3 · Linux · Windows · CI/CD · AI</p>
        </div>
      </div>
    </section>

    <section class="section education shell" id="education">
      <div class="education-card reveal">
        <div>
          <p class="section-kicker" data-scramble>05 / Education</p>
          <h2 data-split>Northern Illinois University</h2>
          <p class="education-degree">Bachelor of Science in Computer Science · 2022</p>
        </div>
        <img class="education-mark" data-float src="/images/niu_logo.png" alt="" aria-hidden="true" />
      </div>
    </section>

    <section class="section shell" id="resume">
      <div class="resume-card reveal">
        <div class="resume-card__header">
          <div>
            <p class="section-kicker" data-scramble>06 / Resume</p>
            <h2 data-split>Resume:</h2>
          </div>
          <div class="resume-lock" aria-hidden="true">PRIVATE</div>
        </div>
        <div class="resume-note">
          <p>Most information is already listed here.</p>
          <p>If you would like my resume, please contact me through LinkedIn.</p>
          <p>I will try to get back to you as soon as possible!</p>
        </div>
        <a class="button button--secondary magnetic" href="#contact">Contact <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="section shell" id="contact">
      <div class="contact-card reveal">
        <p class="section-kicker" data-scramble>07 / Contact</p>
        <h2 data-split>You can find me at:</h2>
        <p>GitHub for code, LinkedIn for the professional side of things, and email when it's necessary.</p>
        <div class="contact-actions">
          <a class="text-link contact-link" href="https://github.com/f-banda" target="_blank" rel="noreferrer">
            <img class="contact-link__icon" src="/images/GitHub_Invertocat_White.png" alt="" aria-hidden="true" />
            <span>GitHub</span>
          </a>
          <a class="text-link contact-link" href="https://www.linkedin.com/in/fbanda/" target="_blank" rel="noreferrer">
            <img class="contact-link__icon" src="/images/InBug-White.png" alt="" aria-hidden="true" />
            <span>LinkedIn</span>
          </a>
          <a class="text-link contact-link" href="#contact" data-chat-open aria-haspopup="dialog">
            <span class="contact-link__icon contact-link__emoji" aria-hidden="true">📧</span>
            <span>Email</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer shell">
    <a class="brand" href="#top" aria-label="Back to top"><span class="brand-mark">FB</span></a>
    <p>Designed & built by Francisco Banda <span id="year"></span></p>
    <a href="#top">Back to top ↑</a>
  </footer>

  <div class="project-modal" data-project-modal aria-hidden="true">
    <div class="project-modal__backdrop" data-project-close></div>
    <div class="project-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="nfl-project-title">
      <button class="project-modal__close" type="button" aria-label="Close project preview" data-project-close>×</button>
      <div class="project-modal__header">
        <p class="section-kicker">03 / Project</p>
        <h3 id="nfl-project-title">NFL Data Visualizer</h3>
      </div>

      <!-- The Observable notebook is fetched the first time this dialog opens (see site.ts). -->
      <div class="nfl" data-nfl>
        <div data-cell="viewof selectedGame"></div>
        <div data-cell="viewof selectedPlayID"></div>
        <div data-cell="viewof frame"></div>
        <div data-cell="viewof playButton"></div>
        <div data-cell="viewof drawBreadcrumbs"></div>
        <div data-cell="playTitle"></div>
        <div data-cell="output"></div>
        <p class="nfl-status" data-nfl-status>Loading the visualizer…</p>
      </div>
    </div>
  </div>

  <ChatWidget />

  <script>
    import { initSite } from '../scripts/site';
    import { initMotion } from '../scripts/motion';
    import { initChat } from '../scripts/chat';
    initSite();
    initChat();
    initMotion();
  </script>
</body>
</html>
